import { createFileRoute, Link } from "@tanstack/react-router";
import { Topbar } from "@/components/topbar";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { uitgiften } from "@/lib/mock-data";
import { Package, Search, Plus, Undo2 } from "lucide-react";
import { useMemo, useState } from "react";
import { cn } from "@/lib/utils";

export const Route = createFileRoute("/modules/uitgifte")({
  head: () => ({
    meta: [
      { title: "Uitgifte — Leen van Punt Intranet" },
      { name: "description", content: "Alle uitgiften: hardware, telefoons, toegangspassen." },
      { property: "og:title", content: "Uitgifte — Leen van Punt Intranet" },
      { property: "og:description", content: "Alle uitgiften: hardware, telefoons, toegangspassen." },
    ],
  }),
  component: UitgiftePage,
});

const soortLabel: Record<string, { label: string; tone: string }> = {
  hardware: { label: "Hardware", tone: "behandeling" },
  telefoon: { label: "Telefoon", tone: "open" },
  toegangspas: { label: "Toegangspas", tone: "wachtend" },
  overig: { label: "Overig", tone: "gesloten" },
};

function UitgiftePage() {
  const [q, setQ] = useState("");
  const [type, setType] = useState<string>("alle");
  const filtered = useMemo(
    () => uitgiften.filter((u) => (type === "alle" || u.soort === type) && (q === "" || u.medewerker.toLowerCase().includes(q.toLowerCase()) || u.item.toLowerCase().includes(q.toLowerCase()))),
    [q, type],
  );

  const kpis = [
    { label: "Totaal uitgiften", value: uitgiften.length, tone: "open" },
    { label: "Openstaand", value: uitgiften.filter((u) => !u.geretourneerd).length, tone: "behandeling" },
    { label: "Deze week", value: uitgiften.filter((u) => ["22 jul", "21 jul", "18 jul"].includes(u.datum)).length, tone: "wachtend" },
    { label: "Geretourneerd", value: uitgiften.filter((u) => u.geretourneerd).length, tone: "opgelost" },
  ];

  return (
    <>
      <Topbar title="Uitgifte" breadcrumbs={["Assets & Beheer"]} />
      <div className="flex-1 overflow-y-auto p-6 space-y-4">
        <section className="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {kpis.map((k) => (
            <Card key={k.label} className="p-4 gap-2">
              <div className="flex items-start justify-between">
                <div className="text-xs font-medium text-muted-foreground">{k.label}</div>
                <div className="grid place-items-center h-7 w-7 rounded-md" style={{ backgroundColor: `var(--status-${k.tone}-bg)`, color: `var(--status-${k.tone})` }}>
                  <Package className="h-3.5 w-3.5" />
                </div>
              </div>
              <div className="text-3xl font-semibold tracking-tight tabular-nums">{k.value}</div>
            </Card>
          ))}
        </section>

        <div className="flex gap-3">
          <div className="relative flex-1">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
            <Input value={q} onChange={(e) => setQ(e.target.value)} placeholder="Zoek op medewerker of item…" className="pl-9 h-9" />
          </div>
          <Button size="sm" className="h-9 gap-1.5"><Plus className="h-3.5 w-3.5" /> Nieuwe uitgifte</Button>
        </div>

        <div className="flex items-center gap-1 overflow-x-auto pb-1">
          {["alle", "hardware", "telefoon", "toegangspas", "overig"].map((s) => (
            <button
              key={s}
              onClick={() => setType(s)}
              className={cn("px-3 py-1.5 rounded-md text-xs font-medium capitalize", type === s ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted")}
            >
              {s === "alle" ? "Alle" : soortLabel[s].label}
            </button>
          ))}
          {uitgiften.filter((u) => u.soort === "hardware").length > 0 && (
            <Link to="/modules/hardware-uitgaven" className="ml-auto text-xs text-primary hover:underline">
              Hardware-specifiek overzicht →
            </Link>
          )}
        </div>

        <Card className="p-0 overflow-hidden">
          <table className="w-full text-sm">
            <thead>
              <tr className="text-[11px] uppercase tracking-wider text-muted-foreground border-b border-border bg-muted/40">
                <th className="text-left font-semibold px-4 py-2.5 w-20">Nummer</th>
                <th className="text-left font-semibold px-2 py-2.5 w-24">Datum</th>
                <th className="text-left font-semibold px-2 py-2.5">Medewerker</th>
                <th className="text-left font-semibold px-2 py-2.5 w-28">Soort</th>
                <th className="text-left font-semibold px-2 py-2.5">Item</th>
                <th className="text-left font-semibold px-2 py-2.5 w-32">Door</th>
                <th className="text-right font-semibold px-4 py-2.5 w-32">Status</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-border">
              {filtered.map((u) => {
                const s = soortLabel[u.soort];
                return (
                  <tr key={u.id} className="hover:bg-muted/40">
                    <td className="px-4 py-3 font-mono text-xs text-muted-foreground">{u.id}</td>
                    <td className="px-2 py-3 text-xs text-muted-foreground">{u.datum}</td>
                    <td className="px-2 py-3">
                      <div className="text-sm font-medium">{u.medewerker}</div>
                      <div className="text-[11px] text-muted-foreground">{u.afdeling}</div>
                    </td>
                    <td className="px-2 py-3">
                      <span className="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset"
                        style={{ backgroundColor: `var(--status-${s.tone}-bg)`, color: `var(--status-${s.tone})`, boxShadow: `inset 0 0 0 1px var(--status-${s.tone})` }}>
                        {s.label}
                      </span>
                    </td>
                    <td className="px-2 py-3 text-sm">{u.item}</td>
                    <td className="px-2 py-3 text-xs text-muted-foreground">{u.uitgegevenDoor}</td>
                    <td className="px-4 py-3 text-right">
                      {u.geretourneerd ? (
                        <span className="inline-flex items-center gap-1 text-[11px] text-status-opgelost">
                          <Undo2 className="h-2.5 w-2.5" /> retour {u.retourDatum}
                        </span>
                      ) : (
                        <span className="text-[11px] text-status-behandeling font-medium">in gebruik</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </Card>
      </div>
    </>
  );
}
